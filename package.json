{
  "name": "task-manager",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng build && node scripts/serve-dist.mjs",
    "serve": "node scripts/serve-dist.mjs",
    "start:dev": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "sheriff": "sheriff verify src/main.ts",
    "mock:generate": "node mock-api/generate-data.js && node mock-api/build-db.js",
    "mock:api": "json-server mock-api/db.json --port 3000",
    "test:arch": "vitest run --config vitest.arch.config.mts",
    "ci": "node scripts/ci-checks.mjs --full",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "test:coverage": "ng test --coverage --watch=false"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular-architects/ngrx-toolkit": "^22.0.0",
    "@angular/cdk": "^22.3.0",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@jsverse/transloco": "^8.4.0",
    "@jsverse/transloco-messageformat": "^8.4.0",
    "@jsverse/utils": "^1.0.0-beta.5",
    "@ngrx/signals": "^22.0.1",
    "@primeuix/themes": "^2.0.3",
    "chart.js": "^4.6.1",
    "primeicons": "^7.0.0",
    "primeng": "^21.1.10",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "overrides": {
    "primeng": {
      "@angular/cdk": "$@angular/cdk",
      "@angular/common": "$@angular/common",
      "@angular/core": "$@angular/core",
      "@angular/forms": "$@angular/forms",
      "@angular/platform-browser": "$@angular/platform-browser",
      "@angular/router": "$@angular/router"
    }
  },
  "devDependencies": {
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.0",
    "@eslint/js": "^10.0.1",
    "@softarc/sheriff-core": "^0.20.0",
    "@vitest/coverage-v8": "^4.1.12",
    "angular-eslint": "^22.8.0",
    "axe-core": "^4.14.1",
    "eslint": "^10.15.0",
    "husky": "^9.1.7",
    "jsdom": "^28.0.0",
    "json-server": "^1.0.0-beta.15",
    "lint-staged": "^17.6.1",
    "prettier": "^3.8.1",
    "tsarch": "^5.4.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.73.0",
    "vitest": "^4.0.8"
  },
  "lint-staged": {
    "*.{ts,html}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,md,scss,mjs,css}": [
      "prettier --write"
    ]
  }
}
